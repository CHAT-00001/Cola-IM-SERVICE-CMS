/// # [GATEWAY] - 可乐短视频网关
/// * `desc`: 网关负责解析参数、前置身份校验（verify_session 走数据库）、按 service 分发到转发器
/// * `转发器`: dispatcher 是二级路由器，按 action 路由到 handler，由 handler 层响应
async fn video_gateway(
    req: HttpRequest,
    query: web::Query<ApiGatewayRequest>,
    body: web::Bytes,
    state: web::Data<AppState>,
) -> impl Responder {
    let start = Instant::now();
    let ctx = &state.ctx;

    // 1️⃣ 接收请求参数结构体（URL + Body JSON 双重命中，Body 为主）
    let url_req = query.into_inner();
    let mut api_req = if !body.is_empty() {
        match serde_json::from_slice::<ApiGatewayRequest>(&body) {
            // 字段级合并：Body 中有值的字段覆盖 URL，Body 缺省的字段保留 URL
            Ok(body_req) => url_req.merge(body_req),
            Err(_) => url_req,
        }
    } else {
        url_req
    };
    api_req = api_req.build();

    // 2️⃣ 前置身份校验：verify_session 走数据库验证 access_token，生成可信 SessionContext
    //    Authorization Header 优先，其次取 body.auth.access_token
    if let Some(access_token) = req
        .headers()
        .get("Authorization")
        .and_then(|v| v.to_str().ok())
        .and_then(|s| s.strip_prefix("Bearer "))
        .map(|s| s.to_string())
    {
        // Header 有 token 时，注入 api_req.auth 供 verify_session 使用
        api_req.auth = Some(cola_data::auth::request::session::AuthSessionRequest {
            access_token: Some(access_token),
            refresh_token: api_req.auth.as_ref().and_then(|a| a.refresh_token.clone()),
            device_id: api_req.auth.as_ref().and_then(|a| a.device_id.clone()),
        });
    }

    let session = match &api_req.auth {
        Some(auth) => {
            // 走数据库真实验证
            let result = verify_session(auth, &ctx.auth).await;
            if result.code == 0 {
                match result.data {
                    Some(s) => {
                        tracing::info!("🔐 [VIDEO GATEWAY]: ✅ verify_session 验证成功, uid = {}", s.uid);
                        s
                    }
                    None => {
                        tracing::warn!("🔐 [VIDEO GATEWAY]: ⚠️ verify_session 无数据，游客");
                        SessionContext::anonymous()
                    }
                }
            } else {
                tracing::warn!("🔐 [VIDEO GATEWAY]: ⚠️ verify_session 失败: {}", result.message);
                SessionContext::anonymous()
            }
        }
        None => {
            tracing::info!("🔐 [VIDEO GATEWAY]: ⚠️ 无 auth 信息，游客访问");
            SessionContext::anonymous()
        }
    };

    // 🔊 调试打印：解析后的 session 数据
    tracing::info!(
        "🔐 [VIDEO GATEWAY]: session = {:?}, service = {:?}, action = {:?}",
        session,
        api_req.service,
        api_req.action,
    );

    // 3️⃣ 分发：按 service 分到不同的转发器（dispatcher 是二级路由器）
    let service_name = api_req.service.clone().unwrap_or_default();
    match service_name.as_str() {
        // 发布添加
        "add" => {
            dispatcher::add::add_dispatch(ctx, &session, &api_req)
                .await
                .finish(&req, start)
        }

        // 主页
        "home" => {
            dispatcher::home::home_dispatch(ctx, &session, &api_req)
                .await
                .finish(&req, start)
        }

        // feed
        "feed" => {
            dispatcher::feed::feed_dispatch(ctx, &session, &api_req)
                .await
                .finish(&req, start)
        }

        // comment
        "comment" => {
            dispatcher::comment::comment_dispatch(ctx, &session, &api_req)
                .await
                .finish(&req, start)
        }

        // danmaku
        "danmaku" => {
            dispatcher::danmaku::danmaku_dispatch(ctx, &session, &api_req)
                .await
                .finish(&req, start)
        }

        // 未知 service
        _ => AppData::<()>::err(4000, format!("[🌐 GATEWAY]: ⚠️ Unknown service: {}", service_name), None)
            .finish(&req, start),
    }
}

