/// # [ADAPTER] - 关注端口适配器
pub struct FollowAdapter;

////////

#[async_trait]
impl FollowAddPort for FollowAdapter {
    async fn upsert_follow_record(&self, uid: i64, target_id: i64) -> anyhow::Result<()> {
        let _ = FollowService::follow(uid, target_id).await?;
        Ok(())
    }

    async fn del_follow(&self, uid: i64, target_id: i64) -> anyhow::Result<()> {
        let _ = FollowService::unfollow(uid, target_id).await?;
        Ok(())
    }

    async fn get_following(&self, uid: i64) -> anyhow::Result<UserInfo> {
        Err(anyhow::anyhow!("not implemented"))
    }

    async fn single_del(&self, uid: i64, target_id: i64) -> anyhow::Result<u16> {
        let _ = FollowService::unfollow(uid, target_id).await?;
        Ok(0)
    }

    async fn batch_del(&self, uid: i64, ids: Vec<i64>) -> anyhow::Result<u16> {
        for id in &ids {
            let _ = FollowService::unfollow(uid, *id).await;
        }
        Ok(ids.len() as u16)
    }

    async fn check_state(&self, uid: i64, target_id: i64) -> anyhow::Result<bool> {
        let ids = FollowService::get_follow_ids(uid, 0, 1).await?;
        Ok(ids.contains(&target_id))
    }

    async fn get_list_by_user_id(&self, user_id: i64, offset: i64, limit: i64) -> anyhow::Result<Vec<i64>> {
        let ids = FollowService::get_follow_ids(user_id, offset, limit).await?;
        Ok(ids)
    }

    async fn get_here_list(&self, _uid: i64, _user_ids: Vec<i64>) -> anyhow::Result<()> {
        Ok(())
    }
}

