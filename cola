use anyhow::{Result, anyhow};
use cola_data::app::ctx::AppContext;
use cola_data::user::vo::user::UserVo;
use tracing::info;

////////

/// # [LIST CASE] - 关注列表 用例
pub struct UserFollowListCase;

impl UserFollowListCase {
    //

    ////////

    /// # 1. [CASE] - 获取我关注的用户VO列表
    /// * `uid` 操作者ID
    /// * `offset` 分页偏移
    /// * `limit` 分页数量
    pub async fn case_get_my_follow_list(
        uid: i64,
        offset: i64,
        limit: i64,
        ctx: &AppContext,
    ) -> Result<Vec<UserVo>, anyhow::Error> {
        // 1. 通过 Port 获取关注用户的 IDs，然后批量查询用户资料 (走缓存)
        let follow_ids = ctx.user
            .follow
            .get
            .get_my_follow_ids(uid, 0, limit, offset)
            .await
            .map_err(|e| anyhow!("[🤐 FOLLOW CASE]: ❌️ 获取我的关注IDs失败: {}", e))?;

        if follow_ids.is_empty() {
            info!("[🗣️ FOLLOW CASE]: ✅️ 我的关注列表为空, uid={}", uid);
            return Ok(vec![]);
        }

        // 2. 批量获取用户Info (port → adapter → service → repo)
        let user_infos = ctx.user
            .info
            .batch_get_info(follow_ids)
            .await
            .map_err(|e| anyhow!("[🤐 FOLLOW CASE]: ❌️ 批量获取用户资料失败: {}", e))?;

        // 3. 🌟 组装 UserVo(动态字段填充)
        let mut vos: Vec<UserVo> = Vec::with_capacity(user_infos.len());
        for info in user_infos {
            // 动态组装: 我关注的人 → is_following=true
            let vo = UserVo::new(info, true, false, false);
            vos.push(vo);
        }

        info!("[🗣️ FOLLOW CASE]: ✅️ 我的关注列表查询成功, uid={}, count={}", uid, vos.len());
        Ok(vos)
    }

    ////////

    /// # 2. [CASE] - 获取TA关注的用户VO列表
    /// * `uid` 当前操作者(用于判断我是否关注了列表中的用户)
    /// * `target_id` 目标用户ID(TA)
    /// * `offset` 分页偏移
    /// * `limit` 分页数量
    pub async fn case_get_he_follow_list(
        uid: i64,
        target_id: i64,
        offset: i64,
        limit: i64,
        ctx: &AppContext,
    ) -> Result<Vec<UserVo>, anyhow::Error> {
        // 1. 获取TA关注的用户IDs
        let follow_ids = ctx.user
            .follow
            .get
            .get_he_follow_ids(target_id, 0, limit, offset)
            .await
            .map_err(|e| anyhow!("[🤐 FOLLOW CASE]: ❌️ 获取TA的关注IDs失败: {}", e))?;

        if follow_ids.is_empty() {
            info!("[🗣️ FOLLOW CASE]: ✅️ TA的关注列表为空, target_id={}", target_id);
            return Ok(vec![]);
        }

        // 2. 批量获取用户Info
        let user_infos = ctx.user
            .info
            .batch_get_info(follow_ids)
            .await
            .map_err(|e| anyhow!("[🤐 FOLLOW CASE]: ❌️ 批量获取用户资料失败: {}", e))?;

        // 3. 🌟 动态组装 UserVo，对每个用户检查我是否已关注
        let mut vos: Vec<UserVo> = Vec::with_capacity(user_infos.len());
        for info in user_infos {
            let is_following = ctx.user
                .follow
                .check
                .is_followed(uid, info.id)
                .await
                .unwrap_or(false);

            let vo = UserVo::new(info, is_following, false, false);
            vos.push(vo);
        }

        info!("[🗣️ FOLLOW CASE]: ✅️ TA的关注列表查询成功, target_id={}, count={}", target_id, vos.len());
        Ok(vos)
    }
}

